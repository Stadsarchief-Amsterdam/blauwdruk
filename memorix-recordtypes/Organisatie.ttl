PREFIX dash: <http://datashapes.org/dash#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX html: <http://www.w3.org/1999/xhtml/>
PREFIX memorix: <http://memorix.io/ontology#>
PREFIX organisation: <https://stadsarchiefamsterdam.memorix.io/resources/recordtypes/Organisation#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX pnv: <https://w3id.org/pnv#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ric-dft: <https://www.ica.org/standards/RiC/vocabularies/documentaryFormTypes#>
PREFIX ric-rst: <https://www.ica.org/standards/RiC/vocabularies/recordSetTypes#>
PREFIX rico: <https://www.ica.org/standards/RiC/ontology#>
PREFIX rt: <https://stadsarchiefamsterdam.memorix.io/resources/recordtypes/>
PREFIX saa: <https://data.archief.amsterdam/ontology#>
PREFIX schema: <http://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX vocabularies: <https://stadsarchiefamsterdam.memorix.io/resources/vocabularies/conceptschemes/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

organisation:identificationGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Identificatie"@nl ;
    sh:order 1.0 .

organisation:alternativeGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Ook bekend als"@nl , "Also known as"@en ;
    sh:order 2.0 .

organisation:managementGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Beheer"@nl , "Management"@en ;
    sh:order 3.0 .

organisation:historyGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Geschiedenis"@nl , "History"@en ;
    sh:order 4.0 .

organisation:rightsGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Rechtenafspraken"@nl , "Rights Agreements"@en ;
    sh:order 5.0 .

rt:Organisation
    rdf:type memorix:Recordtype , sh:NodeShape ;
    rdfs:comment "Organisatie: vastgestelde organisaties, zoals bedrijven of onderdelen van de gemeente"@nl , "Organisation: an established entity, such as a company or a part of the municipality"@en ;
    rdfs:label "Organisatie"@nl , "Organisation"@en ;
    dc:identifier "Organisation" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        rdfs:comment "Naam van de organisatie"@nl , "Name of the organisation"@en ;
        rdfs:label "Naam"@nl , "Name"@en ;
        dash:singleLine true ;
        memorix:inTitleAt 1.0 ;
        memorix:searchWeight 3.0 ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group organisation:identificationGroup ;
        sh:order 1.0 ;
        sh:path schema:name
    ] ;
    sh:property [
        rdfs:label "Onderdeel van organisatie"@nl , "Part of organisation"@en ;
        dash:editor memorix:LinkedRecordEditor ;
        sh:maxCount 1 ;
        sh:message "Kies een organisatie uit de lijst."@nl , "Please choose an organisation."@en ;
        sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class rt:Organisation ] ) ;
        sh:group organisation:identificationGroup ;
        sh:order 2.0 ;
        sh:path rico:isOrWasSubordinateTo
    ] ;
    sh:property [
        rdfs:label "Alternatieve namen"@nl , "Alternate names"@en ;
        memorix:inSummaryAt 3.0 ;
        memorix:searchWeight 2.0 ;
        sh:datatype xsd:string ;
        sh:maxCount 10 ;
        sh:group organisation:alternativeGroup ;
        sh:order 3.0 ;
        sh:path schema:alternateName
    ] ;
    sh:property [
        rdfs:comment "Is identiek aan organisatie in andere terminologiebron"@nl , "Is same as organisation in external vocabulary"@en ;
        rdfs:label "Identiek aan (extern)"@nl , "Is same as (external)"@en ;
        dash:editor memorix:VocabularyEditor ;
        memorix:conceptSchemeIn <https://data.rkd.nl/rkdartists> ;
        memorix:searchWeight 1.0 ;
        sh:class skos:Concept ;
        sh:maxCount 100 ;
        sh:nodeKind sh:IRI ;
        sh:group organisation:alternativeGroup ;
        sh:order 4.0 ;
        sh:path owl:sameAs
    ] ;
    sh:property [
        rdfs:label "Interne opmerkingen"@nl , "Internal remarks"@en ;
        dash:editor dash:TextAreaEditor ;
        memorix:audience memorix:AudienceInternal ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group organisation:managementGroup ;
        sh:order 5.0 ;
        sh:path organisation:internalRemarks
    ] ;
    sh:property [
        rdfs:label "Rechtsopvolger van"@nl , "Successor of"@en ;
        dash:editor memorix:LinkedRecordEditor ;
        sh:maxCount 100 ;
        sh:message "Kies een organisatie uit de lijst."@nl , "Please choose an organisation"@en ;
        sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class rt:Organisation ] ) ;
        sh:group organisation:historyGroup ;
        sh:order 2.0 ;
        sh:path rico:isSuccessorOf
    ] ;
    sh:property [
        rdfs:label "Oprichtingsdatum"@nl , "Date of establishment"@en ;
        memorix:inSummaryAt 1.0 ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:group organisation:historyGroup ;
        sh:order 3.0 ;
        sh:path schema:foundingDate
    ] ;
    sh:property [
        rdfs:label "Bron oprichtingsdatum"@nl , "Source of Date of establishment"@en ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group organisation:historyGroup ;
        sh:order 3.5 ;
        sh:path saa:foundingDateSource
    ] ;
    sh:property [
        rdfs:label "Opheffingsdatum"@nl , "Date of dissolution"@en ;
        memorix:inSummaryAt 2.0 ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:group organisation:historyGroup ;
        sh:order 4.0 ;
        sh:path schema:dissolutionDate
    ] ;
    sh:property [
        rdfs:label "Bron opheffingsdatum"@nl , "Source of Date of dissolution"@en ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group organisation:historyGroup ;
        sh:order 4.5 ;
        sh:path saa:dissolutionDateSource
    ] ;
    sh:property [
        rdfs:label "Auteursrechtafspraken"@nl , "Copyright Agreement"@en ;
        dash:editor memorix:VocabularyEditor ;
        memorix:audience memorix:AudienceInternal ;
        memorix:conceptSchemeIn vocabularies:80216597-805e-4439-abab-f7a323dde6ec ;
        memorix:hidden true ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:group organisation:rightsGroup ;
        sh:order 7.0 ;
        sh:path saa:copyrightsAgreement
    ] ;
    sh:property [
        rdfs:label "Contractnummer"@nl , "Contract Number"@en ;
        dash:editor dash:TextFieldEditor ;
        memorix:audience memorix:AudienceInternal ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group organisation:rightsGroup ;
        sh:order 8.0 ;
        sh:path saa:copyrightsContractNr
    ] ;
    sh:property [
        rdfs:label "Auteursrechtopmerkingen"@nl , "Copyright Remarks"@en ;
        dash:editor dash:TextAreaEditor ;
        memorix:audience memorix:AudienceInternal ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group organisation:rightsGroup ;
        sh:order 9.0 ;
        sh:path saa:copyrightsRemarks
    ] ;
    sh:targetClass rt:Organisation ;
    memorix:copyrightHolderSource true .
