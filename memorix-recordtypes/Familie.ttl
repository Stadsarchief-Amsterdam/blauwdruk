PREFIX dash: <http://datashapes.org/dash#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX family: <https://stadsarchiefamsterdam.memorix.io/resources/recordtypes/Family#>
PREFIX html: <http://www.w3.org/1999/xhtml/>
PREFIX memorix: <http://memorix.io/ontology#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ric-dft: <https://www.ica.org/standards/RiC/vocabularies/documentaryFormTypes#>
PREFIX ric-rst: <https://www.ica.org/standards/RiC/vocabularies/recordSetTypes#>
PREFIX rico: <https://www.ica.org/standards/RiC/ontology#>
PREFIX rt: <https://stadsarchiefamsterdam.memorix.io/resources/recordtypes/>
PREFIX saa: <https://data.archief.amsterdam/ontology#>
PREFIX schema: <http://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX vocabularies: <https://stadsarchiefamsterdam.memorix.io/resources/vocabularies/conceptschemes/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

family:identificationGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Identificatie"@nl ;
    sh:order 1.0 .

family:alternativeGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Ook bekend als"@nl , "Also known as"@en ;
    sh:order 2.0 .

family:managementGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Beheer"@nl , "Management"@en ;
    sh:order 3.0 .

family:rightsGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Rechtenafspraken"@nl , "Rights Agreements"@en ;
    sh:order 4.0 .

rt:Family
    rdf:type memorix:Recordtype , sh:NodeShape ;
    rdfs:comment "Familie: vastgestelde familie(naam) van een familie die een archief heeft gevormd"@nl , "Family: an established family (name) of a family that has created an archive"@en ;
    rdfs:label "Familie"@nl , "Family"@en ;
    dc:identifier "Family" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        rdfs:comment "Naam van de gehele familie"@nl , "Name of a family"@en ;
        rdfs:label "Naam"@nl , "Name"@en ;
        dash:singleLine true ;
        memorix:inTitleAt 1.0 ;
        memorix:searchWeight 3.0 ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group family:identificationGroup ;
        sh:order 1.0 ;
        sh:path schema:name
    ] ;
    sh:property [
        rdfs:label "Alternatieve namen"@nl , "Alternate names"@en ;
        memorix:searchWeight 2.0 ;
        sh:datatype xsd:string ;
        sh:maxCount 10 ;
        sh:group family:alternativeGroup ;
        sh:order 1.0 ;
        sh:path schema:alternateName
    ] ;
    sh:property [
        rdfs:comment "Is identiek aan familie in andere terminologiebron"@nl , "Is same as family in external vocabulary"@en ;
        rdfs:label "Identiek aan (extern)"@nl , "Is same as (external)"@en ;
        dash:editor memorix:VocabularyEditor ;
        memorix:searchWeight 2.0 ;
        sh:class skos:Concept ;
        sh:maxCount 100 ;
        sh:nodeKind sh:IRI ;
        sh:group family:alternativeGroup ;
        sh:order 2.0 ;
        sh:path owl:sameAs
    ] ;
    sh:property [
        rdfs:label "Interne opmerking"@nl , "Internal remarks"@en ;
        dash:editor dash:TextAreaEditor ;
        memorix:audience memorix:AudienceInternal ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group family:managementGroup ;
        sh:order 1.0 ;
        sh:path family:internalRemarks
    ] ;
    sh:property [
        rdfs:label "Auteursrechtafspraken"@nl , "Copyright Agreement"@en ;
        dash:editor memorix:VocabularyEditor ;
        memorix:conceptSchemeIn vocabularies:80216597-805e-4439-abab-f7a323dde6ec ;
        memorix:hidden true ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:group family:rightsGroup ;
        sh:order 7.0 ;
        sh:path saa:copyrightsAgreement
    ] ;
    sh:property [
        rdfs:label "Contractnummer"@nl , "Contract Number"@en ;
        dash:editor dash:TextFieldEditor ;
        memorix:audience memorix:AudienceInternal ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group family:rightsGroup ;
        sh:order 8.0 ;
        sh:path saa:copyrightsContractNr
    ] ;
    sh:property [
        rdfs:label "Auteursrechtopmerkingen"@nl , "Copyright Remarks"@en ;
        dash:editor dash:TextAreaEditor ;
        memorix:audience memorix:AudienceInternal ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group family:rightsGroup ;
        sh:order 9.0 ;
        sh:path saa:copyrightsRemarks
    ] ;
    sh:targetClass rt:Family ;
    memorix:copyrightHolderSource true .
