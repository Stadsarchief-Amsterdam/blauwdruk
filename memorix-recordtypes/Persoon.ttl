PREFIX dash: <http://datashapes.org/dash#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX html: <http://www.w3.org/1999/xhtml/>
PREFIX memorix: <http://memorix.io/ontology#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX person: <https://stadsarchiefamsterdam.memorix.io/resources/recordtypes/Person#>
PREFIX pnv: <https://w3id.org/pnv#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ric-dft: <https://www.ica.org/standards/RiC/vocabularies/documentaryFormTypes#>
PREFIX ric-rst: <https://www.ica.org/standards/RiC/vocabularies/recordSetTypes#>
PREFIX rico: <https://www.ica.org/standards/RiC/ontology#>
PREFIX rt: <https://stadsarchiefamsterdam.memorix.io/resources/recordtypes/>
PREFIX saa: <https://data.archief.amsterdam/ontology#>
PREFIX schema: <http://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX vocabularies: <https://stadsarchiefamsterdam.memorix.io/resources/vocabularies/conceptschemes/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

person:identificationGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Identificatie"@nl , "Identification"@en ;
    sh:order 1.0 .

person:alternativeGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Ook bekend als"@nl , "Also known as"@en ;
    sh:order 2.0 .

person:managementGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Beheer"@nl , "Manage"@en ;
    sh:order 3.0 .

person:rightsGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Rechtenafspraken"@nl , "Rights Agreements"@en ;
    sh:order 4.0 .

rt:Person
    rdf:type memorix:Recordtype , sh:NodeShape ;
    rdfs:comment "Persoon: vastgestelde personen die een archief hebben gevormd en/of een archiefstuk hebben gemaakt en/of afgebeeld staan"@nl , "Person: an established individual who created an archive or an image, or is depicted on a record"@en ;
    rdfs:label "Persoon"@nl , "Person"@en ;
    dc:identifier "Person" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        rdfs:label "Naam"@nl , "Name"@en ;
        sh:class pnv:PersonName ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNode ;
        sh:group person:identificationGroup ;
        sh:order 1.0 ;
        sh:path pnv:hasName
    ] ;
    sh:property [
        rdfs:comment "Geef een jaartal"@nl ;
        rdfs:label "Geboortejaar"@nl , "Year of birth"@en ;
        memorix:inTitleAt 4.0 ;
        sh:datatype xsd:gYear ;
        sh:maxCount 1 ;
        sh:maxInclusive "2200"^^xsd:gYear ;
        sh:minInclusive "1200"^^xsd:gYear ;
        sh:group person:identificationGroup ;
        sh:order 5.0 ;
        sh:path schema:birthDate
    ] ;
    sh:property [
        rdfs:label "Geboorteplaats"@nl , "Place of birth"@en ;
        dash:editor dash:TextFieldEditor ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group person:identificationGroup ;
        sh:order 6.0 ;
        sh:path schema:birthPlace
    ] ;
    sh:property [
        rdfs:comment "Geef een jaartal"@nl ;
        rdfs:label "Overlijdensjaar"@nl , "Year of death"@en ;
        memorix:inTitleAt 5.0 ;
        sh:datatype xsd:gYear ;
        sh:maxCount 1 ;
        sh:maxInclusive "2200"^^xsd:gYear ;
        sh:minInclusive "1200"^^xsd:gYear ;
        sh:group person:identificationGroup ;
        sh:order 7.0 ;
        sh:path schema:deathDate
    ] ;
    sh:property [
        rdfs:label "Overlijdensplaats"@nl , "Place of death"@en ;
        dash:editor dash:TextFieldEditor ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group person:identificationGroup ;
        sh:order 8.0 ;
        sh:path schema:deathPlace
    ] ;
    sh:property [
        rdfs:label "Alternatieve namen"@nl , "Alternate names"@en ;
        memorix:inSummaryAt 1.0 ;
        memorix:searchWeight 2.0 ;
        sh:datatype xsd:string ;
        sh:maxCount 10 ;
        sh:group person:alternativeGroup ;
        sh:order 1.0 ;
        sh:path schema:alternateName
    ] ;
    sh:property [
        rdfs:label "Identiek aan (extern)"@nl , "Is same as (external)"@en ;
        dash:editor memorix:VocabularyEditor ;
        memorix:conceptSchemeIn <https://www.wikidata.org#entities-persons> ;
        memorix:searchWeight 1.0 ;
        sh:class skos:Concept ;
        sh:maxCount 100 ;
        sh:nodeKind sh:IRI ;
        sh:group person:alternativeGroup ;
        sh:order 2.0 ;
        sh:path owl:sameAs
    ] ;
    sh:property [
        rdfs:label "Interne opmerking"@nl , "Internal remarks"@en ;
        dash:editor dash:TextAreaEditor ;
        memorix:audience memorix:AudienceInternal ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group person:managementGroup ;
        sh:order 1.0 ;
        sh:path person:internalRemarks
    ] ;
    sh:property [
        rdfs:label "Auteursrechtafspraken"@nl , "Copyright Agreement"@en ;
        dash:editor memorix:VocabularyEditor ;
        memorix:conceptSchemeIn vocabularies:80216597-805e-4439-abab-f7a323dde6ec ;
        memorix:hidden true ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:group person:rightsGroup ;
        sh:order 7.0 ;
        sh:path saa:copyrightsAgreement
    ] ;
    sh:property [
        rdfs:label "Contractnummer"@nl , "Contract Number"@en ;
        dash:editor dash:TextFieldEditor ;
        memorix:audience memorix:AudienceInternal ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group person:rightsGroup ;
        sh:order 8.0 ;
        sh:path saa:copyrightsContractNr
    ] ;
    sh:property [
        rdfs:label "Auteursrechtopmerkingen"@nl , "Copyright Remarks"@en ;
        dash:editor dash:TextAreaEditor ;
        memorix:audience memorix:AudienceInternal ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group person:rightsGroup ;
        sh:order 9.0 ;
        sh:path saa:copyrightsRemarks
    ] ;
    sh:targetClass rt:Person ;
    memorix:copyrightHolderSource true .

pnv:PersonName
    rdf:type sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        rdfs:label "Voornaam"@nl , "First name"@en ;
        memorix:inTitleAt 2.0 ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group person:identificationGroup ;
        sh:order 1.0 ;
        sh:path pnv:givenName
    ] ;
    sh:property [
        rdfs:label "Initialen"@nl , "Initials"@en ;
        dash:singleLine true ;
        memorix:inTitleAt 4.0 ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group person:identificationGroup ;
        sh:order 2.0 ;
        sh:path pnv:initials
    ] ;
    sh:property [
        rdfs:label "Tussenvoegsel"@nl , "Surname prefix"@en ;
        memorix:inTitleAt 3.0 ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group person:identificationGroup ;
        sh:order 3.0 ;
        sh:path pnv:surnamePrefix
    ] ;
    sh:property [
        rdfs:label "Achternaam"@nl , "Surname"@en ;
        memorix:inTitleAt 1.0 ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "Achternaam is verplicht"@nl , "Surname is required"@en ;
        sh:group person:identificationGroup ;
        sh:order 4.0 ;
        sh:path pnv:baseSurname
    ] ;
    sh:targetClass pnv:PersonName .
