PREFIX conservationReport: <https://stadsarchiefamsterdam.memorix.io/resources/recordtypes/ConservationReport#>
PREFIX dash: <http://datashapes.org/dash#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX file: <https://stadsarchiefamsterdam.memorix.io/resources/recordtypes/File#>
PREFIX html: <http://www.w3.org/1999/xhtml/>
PREFIX memorix: <http://memorix.io/ontology#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ric-dft: <https://www.ica.org/standards/RiC/vocabularies/documentaryFormTypes#>
PREFIX ric-rst: <https://www.ica.org/standards/RiC/vocabularies/recordSetTypes#>
PREFIX rico: <https://www.ica.org/standards/RiC/ontology#>
PREFIX rt: <https://stadsarchiefamsterdam.memorix.io/resources/recordtypes/>
PREFIX saa: <https://data.archief.amsterdam/ontology#>
PREFIX schema: <http://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX vocabularies: <https://stadsarchiefamsterdam.memorix.io/resources/vocabularies/conceptschemes/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

conservationReport:identificationGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Identificatie"@nl , "Identification"@en ;
    sh:order 1.0 .

conservationReport:descriptionGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Objectbeschrijving"@nl , "Object Description"@en ;
    sh:order 2.0 .

conservationReport:conditionGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Conditie"@nl , "Condition"@en ;
    sh:order 3.0 .

conservationReport:investigationGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Vooronderzoek"@nl , "Preliminary Investigation"@en ;
    sh:order 4.0 .

conservationReport:treatmentGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Behandeling"@nl , "Treatment"@en ;
    sh:order 5.0 .

conservationReport:managementGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Beheer"@nl , "Manage"@en ;
    sh:order 6.0 .

rt:ConservationReport
    rdf:type memorix:Recordtype , sh:NodeShape ;
    rdfs:comment "Stadsarchief recordtype voor Conserveringsrapport"@nl ;
    rdfs:label "Conserveringsrapport"@nl , "Conservation report"@en ;
    dc:identifier "ConservationReport" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property conservationReport:FondsShape ;
    sh:property conservationReport:FileShape ;
    sh:property conservationReport:BeginDateShape ;
    sh:property conservationReport:EndDateShape ;
    sh:property conservationReport:ObjectDescriptionShape ;
    sh:property conservationReport:ObjectTypeShape ;
    sh:property conservationReport:ObjectMaterialShape ;
    sh:property conservationReport:ObjectTechniqueShape ;
    sh:property conservationReport:PrimaryCarrierShape ;
    sh:property conservationReport:MediumShape ;
    sh:property conservationReport:SecondaryAdditionShape ;
    sh:property conservationReport:DamageShape ;
    sh:property conservationReport:AcidityShape ;
    sh:property conservationReport:HasCarriedOutTestsShape ;
    sh:property conservationReport:OtherFindingsShape ;
    sh:property conservationReport:HasDamageTreatmentShape ;
    sh:property conservationReport:OtherTreatmentShape ;
    sh:property conservationReport:ExternalConservatorShape ;
    sh:property conservationReport:InternalRemarksShape ;
    sh:targetClass rt:ConservationReport ;
    memorix:audience memorix:AudienceInternal .

conservationReport:FondsShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Archief"@nl , "Fonds"@en ;
    dash:editor memorix:LinkedRecordEditor ;
    memorix:typeOf memorix:FondsFieldLink ;
    sh:description "Archief waar dit rapport bij hoort"@nl , "Fonds to which this report belongs"@en ;
    sh:maxCount 1 ;
    sh:message "Kies het archief waar dit rapport uit komt"@nl , "Choose a fonds where this report belongs to"@en ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:or ( [ sh:class rt:Fonds ] ) ;
    sh:group conservationReport:identificationGroup ;
    sh:order 1.0 ;
    sh:path saa:isOrWasAlsoIncludedIn .

conservationReport:FileShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Bestanddeel"@nl , "Linked file"@en ;
    dash:editor memorix:ConditionalLinkFieldEditor ;
    memorix:conditionalLinkField saa:isOrWasAlsoIncludedIn ;
    memorix:linkField [
        memorix:hasRecordType rt:File ;
        memorix:path file:fonds
    ] ;
    sh:description "Bestanddeel waartoe dit rapport behoort"@nl , "The file where this report belongs to"@en ;
    sh:maxCount 1 ;
    sh:message "Kies een bestanddeel om aan te koppelen. Dit is verplicht."@nl , "Choose a related (inventory) file. It is required."@en ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:or ( [ sh:class rt:File ] ) ;
    sh:group conservationReport:identificationGroup ;
    sh:order 2.0 ;
    sh:path rico:isOrWasIncludedIn .

conservationReport:BeginDateShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Begindatum"@nl , "Begin date"@en ;
    memorix:inTitleAt 1.0 ;
    memorix:searchWeight 5.0 ;
    sh:datatype xsd:date ;
    sh:maxCount 1 ;
    sh:message "Vul tenminste een begindatum in. Dit is verplicht."@nl , "Please provide a begin date. This is mandatory."@en ;
    sh:minCount 1 ;
    sh:group conservationReport:identificationGroup ;
    sh:order 3.0 ;
    sh:path rico:hasBeginningDate .

conservationReport:EndDateShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Einddatum"@nl , "End date"@en ;
    sh:datatype xsd:date ;
    sh:maxCount 1 ;
    sh:group conservationReport:identificationGroup ;
    sh:order 4.0 ;
    sh:path rico:hasEndDate .

conservationReport:ObjectDescriptionShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Specificatie bestanddeel"@nl , "Specification of the record"@en ;
    dash:editor dash:TextAreaEditor ;
    memorix:searchWeight 3.0 ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:group conservationReport:descriptionGroup ;
    sh:order 1.0 ;
    sh:path rico:title .

conservationReport:ObjectTypeShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Objecttype"@nl , "Object type"@en ;
    dash:editor memorix:VocabularyEditor ;
    memorix:conceptSchemeIn vocabularies:1cc20db0-62dc-45cf-b7f7-c7b2fb2074a2 ;
    memorix:inSummaryAt 1.0 ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:message "Kies een objecttype uit de keuzelijst."@nl , "Please choose a object type from the list."@en ;
    sh:nodeKind sh:IRI ;
    sh:group conservationReport:descriptionGroup ;
    sh:order 2.0 ;
    sh:path rico:hasDocumentaryFormType .

conservationReport:ObjectMaterialShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Materiaal drager"@nl , "Material of carrier"@en ;
    dash:editor memorix:VocabularyEditor ;
    memorix:conceptSchemeIn vocabularies:ae2e509f-ad1b-4dc3-bf0d-0fb9bc7e7863 ;
    sh:class skos:Concept ;
    sh:maxCount 50 ;
    sh:message "Kies een materiaal uit de keuzelijst."@nl , "Please choose a type of material from the list."@en ;
    sh:nodeKind sh:IRI ;
    sh:group conservationReport:descriptionGroup ;
    sh:order 3.0 ;
    sh:path saa:material .

conservationReport:ObjectTechniqueShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Techniek of procedé"@nl , "Technique"@en ;
    dash:editor memorix:VocabularyEditor ;
    memorix:conceptSchemeIn vocabularies:d0fc28e9-e1c0-47c0-ad66-f496c8d12f90 ;
    sh:class skos:Concept ;
    sh:maxCount 50 ;
    sh:message "Kies een techniek uit de keuzelijst."@nl , "Please choose a technique from the list."@en ;
    sh:nodeKind sh:IRI ;
    sh:group conservationReport:descriptionGroup ;
    sh:order 4.0 ;
    sh:path saa:technique .

conservationReport:PrimaryCarrierShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Conditie primaire drager"@nl , "Condition Primary carrier"@en ;
    dash:editor memorix:VocabularyEditor ;
    memorix:conceptSchemeIn vocabularies:d3538eb3-e234-4c41-99f5-38ddbfce7e36 ;
    sh:class skos:Concept ;
    sh:maxCount 50 ;
    sh:message "Kies een term uit de keuzelijst."@nl , "Please choose from the list."@en ;
    sh:nodeKind sh:IRI ;
    sh:group conservationReport:conditionGroup ;
    sh:order 1.0 ;
    sh:path conservationReport:primaryCarrier .

conservationReport:MediumShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Conditie medium"@nl , "Condition Medium"@en ;
    dash:editor memorix:VocabularyEditor ;
    memorix:conceptSchemeIn vocabularies:d3538eb3-e234-4c41-99f5-38ddbfce7e36 ;
    sh:class skos:Concept ;
    sh:maxCount 50 ;
    sh:message "Kies een term uit de keuzelijst."@nl , "Please choose from the list."@en ;
    sh:nodeKind sh:IRI ;
    sh:group conservationReport:conditionGroup ;
    sh:order 2.0 ;
    sh:path conservationReport:medium .

conservationReport:SecondaryAdditionShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Conditie toevoeging"@nl , "Condition addition"@en ;
    dash:editor memorix:VocabularyEditor ;
    memorix:conceptSchemeIn vocabularies:d3538eb3-e234-4c41-99f5-38ddbfce7e36 ;
    sh:class skos:Concept ;
    sh:maxCount 50 ;
    sh:message "Kies een term uit de keuzelijst."@nl , "Please choose from the list."@en ;
    sh:nodeKind sh:IRI ;
    sh:group conservationReport:conditionGroup ;
    sh:order 3.0 ;
    sh:path conservationReport:secondaryAddition .

conservationReport:DamageShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Conditie overig"@nl , "Condition (other)"@en ;
    dash:editor dash:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:group conservationReport:conditionGroup ;
    sh:order 4.0 ;
    sh:path conservationReport:otherDamage .

conservationReport:WorkloadShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Werkvoorraad?"@nl , "Workload?"@en ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:group conservationReport:conditionGroup ;
    sh:order 5.0 ;
    sh:path conservationReport:workload .

conservationReport:AcidityShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Azijnzuurgas (A-D strips)"@nl , "Acidity (A-D strips)"@en ;
    html:placeholder "0,1,2,3 of 4"@nl , "0,1,2,3 or 4"@en ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 ;
    sh:maxInclusive 4 ;
    sh:message "Zuurgraad moet liggen tussen 0 en 4"@nl , "Acidity must be between 0 and 4"@en ;
    sh:minInclusive 0 ;
    sh:group conservationReport:investigationGroup ;
    sh:order 6.0 ;
    sh:path conservationReport:acidity .

conservationReport:HasCarriedOutTestsShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Uitgevoerde tests"@nl , "Carried out tests"@en ;
    sh:class conservationReport:CarriedOutTests ;
    sh:maxCount 50 ;
    sh:nodeKind sh:BlankNode ;
    sh:group conservationReport:investigationGroup ;
    sh:order 6.0 ;
    sh:path conservationReport:hasCarriedOutTests .

conservationReport:OtherFindingsShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Vooronderzoek overig"@nl , "Other preliminary results"@en ;
    dash:editor dash:TextAreaEditor ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:group conservationReport:investigationGroup ;
    sh:order 9.0 ;
    sh:path conservationReport:otherFindings .

conservationReport:HasDamageTreatmentShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Behandelingen"@nl , "Treatments"@en ;
    sh:class conservationReport:DamageTreatment ;
    sh:maxCount 50 ;
    sh:nodeKind sh:BlankNode ;
    sh:group conservationReport:treatmentGroup ;
    sh:order 1.0 ;
    sh:path conservationReport:hasDamageTreatment .

conservationReport:OtherTreatmentShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Behandeling overig"@nl , "Treatment other"@en ;
    dash:editor dash:TextAreaEditor ;
    memorix:audience memorix:AudienceInternal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:group conservationReport:treatmentGroup ;
    sh:order 2.0 ;
    sh:path conservationReport:otherTreatment .

conservationReport:ExternalConservatorShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Externe behandelaar"@nl , "External conservator"@en ;
    memorix:audience memorix:AudienceInternal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:group conservationReport:treatmentGroup ;
    sh:order 3.0 ;
    sh:path conservationReport:externalConservator .

conservationReport:InternalRemarksShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Interne opmerking"@nl , "Internal remarks"@en ;
    dash:editor dash:TextAreaEditor ;
    memorix:audience memorix:AudienceInternal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:group conservationReport:managementGroup ;
    sh:order 1.0 ;
    sh:path saa:internalRemarks .

conservationReport:CarriedOutTests
    rdf:type sh:NodeShape ;
    rdfs:label "Uitgevoerde test"@nl , "Test that was carried out"@en ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        rdfs:label "Soort test"@nl , "Type of test"@en ;
        dash:editor memorix:VocabularyEditor ;
        memorix:conceptSchemeIn vocabularies:acf7fe80-0bb0-4411-8870-eb008830c55f ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:order 1.0 ;
        sh:path conservationReport:typeOfTest
    ] ;
    sh:property [
        rdfs:label "Uitslag"@nl , "Result"@en ;
        html:placeholder "positief/negatief"@nl ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 2.0 ;
        sh:path conservationReport:resultOfTest
    ] ;
    sh:targetClass conservationReport:CarriedOutTests .

conservationReport:DamageTreatment
    rdf:type sh:NodeShape ;
    rdfs:label "Behandeling"@nl , "Treatment"@en ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        rdfs:label "Onderdeel behandeling"@nl , "Treated part"@en ;
        dash:editor memorix:VocabularyEditor ;
        memorix:conceptSchemeIn vocabularies:d3538eb3-e234-4c41-99f5-38ddbfce7e36 ;
        sh:class skos:Concept ;
        sh:maxCount 20 ;
        sh:nodeKind sh:IRI ;
        sh:order 1.0 ;
        sh:path conservationReport:typeOfDamage
    ] ;
    sh:property [
        rdfs:label "Behandeling"@nl , "Treatment"@en ;
        dash:editor memorix:VocabularyEditor ;
        memorix:conceptSchemeIn vocabularies:3f4bdac4-51af-497a-af8f-24e86bc30c55 ;
        sh:class skos:Concept ;
        sh:maxCount 20 ;
        sh:nodeKind sh:IRI ;
        sh:order 2.0 ;
        sh:path conservationReport:typeOfTreatment
    ] ;
    sh:property [
        rdfs:label "Middel behandeling"@nl , "Treated with"@en ;
        dash:editor memorix:VocabularyEditor ;
        memorix:conceptSchemeIn vocabularies:99cef907-bfbd-47b3-a277-895ee6b608f8 ;
        sh:class skos:Concept ;
        sh:maxCount 20 ;
        sh:nodeKind sh:IRI ;
        sh:order 3.0 ;
        sh:path conservationReport:typeOfMaterial
    ] ;
    sh:targetClass conservationReport:DamageTreatment .
