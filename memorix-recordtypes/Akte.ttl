PREFIX dash: <http://datashapes.org/dash#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX deed: <https://stadsarchiefamsterdam.memorix.io/resources/recordtypes/Deed#>
PREFIX file: <https://stadsarchiefamsterdam.memorix.io/resources/recordtypes/File#>
PREFIX html: <http://www.w3.org/1999/xhtml/>
PREFIX memorix: <http://memorix.io/ontology#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ric-dft: <https://www.ica.org/standards/RiC/vocabularies/documentaryFormTypes#>
PREFIX ric-rst: <https://www.ica.org/standards/RiC/vocabularies/recordSetTypes#>
PREFIX rico: <https://www.ica.org/standards/RiC/ontology#>
PREFIX rt: <https://stadsarchiefamsterdam.memorix.io/resources/recordtypes/>
PREFIX saa: <https://data.archief.amsterdam/ontology#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX vocabularies: <https://stadsarchiefamsterdam.memorix.io/resources/vocabularies/conceptschemes/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

deed:identificationGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Akte"@nl , "Deed"@en ;
    sh:order 1.0 .

deed:personGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Personen"@nl , "People"@en ;
    sh:order 2.0 .

deed:addressGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Adres"@nl , "Address"@en ;
    sh:order 3.0 .

deed:locationGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Locatie"@nl , "Location"@en ;
    sh:order 4.0 .

deed:managementGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Beheer"@nl , "Manage"@en ;
    sh:order 5.0 .

rt:Deed
    rdf:type memorix:Recordtype , sh:NodeShape ;
    rdfs:comment "Akte: registratie van een gebeurtenis, zoals een verhuizing of geboorte"@nl , "Deed: a record of an event, such as a change of residence or birth"@en ;
    rdfs:label "Akte"@nl , "Deed"@en ;
    dc:identifier "Deed" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property deed:FondsShape ;
    sh:property deed:FileShape ;
    sh:property deed:TitleShape ;
    sh:property deed:DocumentaryFormShape ;
    sh:property deed:AssociatedWithDateTextShape ;
    sh:property deed:AssociatedWithDateShape ;
    sh:property deed:SourceShape ;
    sh:property deed:IndexNameShape ;
    sh:property deed:HasOrHadCategoryShape ;
    sh:property deed:SpecificationShape ;
    sh:property deed:HasOrHadSubjectShape ;
    sh:property deed:HasOrHadLocation1851Shape ;
    sh:property deed:HasOrHadLocation1853Shape ;
    sh:property deed:HasOrHadModernLocationShape ;
    sh:property saa:hasOrHadSubjectBAGLocation ;
    sh:property saa:hasOrHadSubjectBAGIdentifier ;
    sh:property saa:hasOrHadSubjectLocation ;
    sh:property saa:hasOrHadSubjectCoordinates ;
    sh:property deed:LocationShape ;
    sh:property deed:AddressHouseNameShape ;
    sh:property deed:AddressPlaceShape ;
    sh:property deed:AddressDescriptionShape ;
    sh:property deed:LodationIRIShape ;
    sh:property deed:InternalRemarksShape ;
    sh:property deed:PositionOnScanShape ;
    sh:targetClass rt:Deed ;
    memorix:hasInformationComponent [ rdf:type memorix:DigitalAssetComponent ] ;
    owl:equivalentClass rico:Record .

deed:FondsShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Archief"@nl , "Fonds"@en ;
    dash:editor memorix:LinkedRecordEditor ;
    memorix:inSummaryAt 2.0 ;
    memorix:typeOf memorix:FondsFieldLink ;
    sh:description "Archief waar deze akte bij hoort"@nl , "Fonds to which this deed belongs"@en ;
    sh:maxCount 1 ;
    sh:message "Kies het archief waar deze akte uit komt"@nl , "Choose a fonds where this deed belongs to"@en ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:or ( [ sh:class rt:Fonds ] ) ;
    sh:group deed:identificationGroup ;
    sh:order 1.0 ;
    sh:path saa:isOrWasAlsoIncludedIn .

deed:FileShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Bestanddeel"@nl , "Linked file"@en ;
    dash:editor memorix:ConditionalLinkFieldEditor ;
    memorix:conditionalLinkField saa:isOrWasAlsoIncludedIn ;
    memorix:linkField [
        memorix:hasRecordType rt:File ;
        memorix:path file:fonds
    ] ;
    sh:description "Bestanddeel waartoe deze akte behoort"@nl , "The file where this deed belongs to"@en ;
    sh:maxCount 1 ;
    sh:message "Kies een bestanddeel om aan te koppelen. Dit is verplicht."@nl , "Choose a related (inventory) file. It is required."@en ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:or ( [ sh:class rt:File ] ) ;
    sh:group deed:identificationGroup ;
    sh:order 2.0 ;
    sh:path rico:isOrWasIncludedIn .

deed:TitleShape
    rdf:type sh:PropertyShape ;
    rdfs:comment "Gemigreerde titel, t.b.v. de Memorix interface"@nl ;
    rdfs:label "Titel"@nl , "Title"@en ;
    memorix:inTitleAt 1.0 ;
    memorix:searchWeight 5.0 ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:group deed:identificationGroup ;
    sh:order 3.0 ;
    sh:path rico:title .

deed:DocumentaryFormShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Aktetype"@nl , "Type of record"@en ;
    dash:editor memorix:VocabularyEditor ;
    memorix:conceptSchemeIn vocabularies:507fab73-142b-4076-a18c-df21a21cb3b0 ;
    memorix:searchWeight 3.0 ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:group deed:identificationGroup ;
    sh:order 4.0 ;
    sh:path rico:hasDocumentaryFormType .

deed:AssociatedWithDateTextShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Datum van de akte (incompleet)"@nl , "Date of the record (incomplete)"@en ;
    memorix:searchWeight 3.0 ;
    sh:datatype xsd:string ;
    sh:description "Gebruik alleen bij incomplete datums, bijv. 22-01-19xx of 22-xx-1940"@nl , "Only use for incomplete dates, e.g., 22-01-19xx or 22-xx-1940"@en ;
    sh:maxCount 1 ;
    sh:message "Fout: schrijf dd-mm-yyyy en gebruik kleine x waar incompleet"@nl , "Wrong format: use dd-mm-yyyy and small x where incomplete"@en ;
    sh:pattern "^(\\d|x)(\\d|x)-(\\d|x)(\\d|x)-(\\d|x)(\\d|x)(\\d|x)(\\d|x)$" ;
    sh:group deed:identificationGroup ;
    sh:order 5.0 ;
    sh:path rico:expressedDate .

deed:AssociatedWithDateShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Datum van de akte"@nl , "Date of the record"@en ;
    memorix:searchWeight 3.0 ;
    sh:datatype xsd:date ;
    sh:maxCount 1 ;
    sh:group deed:identificationGroup ;
    sh:order 6.0 ;
    sh:path rico:normalizedDateValue .

deed:SourceShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Bronverwijzing"@nl , "Mention of the source"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:group deed:identificationGroup ;
    sh:order 7.0 ;
    sh:path saa:source .

deed:IndexNameShape
    rdf:type sh:PropertyShape ;
    rdfs:comment "Huidige naam van de index."@nl , "Current name of the index"@en ;
    rdfs:label "Index Naam (oud)"@nl , "Name of the index (old)"@en ;
    memorix:audience memorix:AudienceInternal ;
    memorix:hidden true ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:group deed:identificationGroup ;
    sh:order 8.0 ;
    sh:path saa:indexName .

deed:HasOrHadCategoryShape
    rdf:type sh:PropertyShape ;
    rdfs:comment "Huidige naam van de index."@nl , "Current name of the index"@en ;
    rdfs:label "Index"@nl , "Index"@en ;
    dash:editor memorix:VocabularyEditor ;
    memorix:conceptSchemeIn vocabularies:846bc006-31c6-4a58-b6c2-31d0349553c5 ;
    memorix:inSummaryAt 1.0 ;
    memorix:searchWeight 2.0 ;
    sh:class skos:Concept ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:group deed:identificationGroup ;
    sh:order 9.0 ;
    sh:path rico:hasOrHadCategory .

deed:SpecificationShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Bijzonderheden"@nl , "Details"@en ;
    sh:class saa:Specification ;
    sh:maxCount 100 ;
    sh:nodeKind sh:BlankNode ;
    sh:group deed:identificationGroup ;
    sh:order 11.0 ;
    sh:path saa:hasSpecification .

deed:HasOrHadSubjectShape
    rdf:type sh:PropertyShape ;
    rdfs:comment "Personen die voorkomen op de akte."@nl , "People mentioned in the source"@en ;
    rdfs:label "Personen"@nl , "People"@en ;
    dash:viewer dash:DetailsEditor ;
    sh:class saa:LinkedPersonObservation ;
    sh:maxCount 999 ;
    sh:nodeKind sh:BlankNode ;
    sh:group deed:personGroup ;
    sh:order 3.0 ;
    sh:path rico:hasOrHadSubject .

deed:HasOrHadLocation1851Shape
    rdf:type sh:PropertyShape ;
    rdfs:comment "Adres zoals het voorkomt in de bron."@nl , "Address mentioned in the source"@en ;
    rdfs:label "Adres uit 1851-1853"@nl , "Address in 1851-1853"@en ;
    sh:class saa:HistoricalAddress1851 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNode ;
    sh:group deed:addressGroup ;
    sh:order 3.0 ;
    sh:path saa:isAssociatedWithHistoricalAddress1851 .

deed:HasOrHadLocation1853Shape
    rdf:type sh:PropertyShape ;
    rdfs:label "Adres uit 1853-1874"@nl , "Address in 1853-1874"@en ;
    sh:class saa:HistoricalAddress1853 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNode ;
    sh:group deed:addressGroup ;
    sh:order 4.0 ;
    sh:path saa:isAssociatedWithHistoricalAddress1853 .

deed:HasOrHadModernLocationShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Modern adres"@nl , "Modern Address"@en ;
    sh:class saa:Address ;
    sh:maxCount 1 ;
    sh:nodeKind sh:BlankNode ;
    sh:group deed:addressGroup ;
    sh:order 5.0 ;
    sh:path saa:isAssociatedWithModernAddress .

saa:hasOrHadSubjectBAGLocation
    rdf:type sh:PropertyShape ;
    rdfs:label "Locatie URI (BAG)"@nl , "Location URI (BAG)"@en ;
    dash:editor memorix:IriEditor ;
    sh:description "Plak hier eeen BAG URI in"@nl , "Please provide a BAG URI"@en ;
    sh:flags "i" ;
    sh:maxCount 1000 ;
    sh:message "Waarde moet beginnen met http of https"@nl , "Value must start with http:// or https://"@en ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://" ;
    sh:group deed:addressGroup ;
    sh:order 10.0 ;
    sh:path saa:hasOrHadSubjectBAGLocation .

saa:hasOrHadSubjectBAGIdentifier
    rdf:type sh:PropertyShape ;
    rdfs:label "Locatie (BAG) identifier"@nl , "Location (BAG) identifier"@en ;
    dash:singleLine true ;
    sh:datatype xsd:string ;
    sh:description "BAG identifier (alleen cijfers)"@nl , "BAG identifier, containing only numbers"@en ;
    sh:maxCount 1000 ;
    sh:message "De waarde moet een BAG identifier zijn (uitsluitend cijfers)"@nl , "Value must be a BAG ID conatining solely numbers"@en ;
    sh:group deed:addressGroup ;
    sh:order 11.0 ;
    sh:path saa:hasOrHadSubjectBAGIdentifier .

saa:hasOrHadSubjectLocation
    rdf:type sh:PropertyShape ;
    rdfs:label "Locatie URI (Adamlink)"@nl , "Location URI (Adamlink)"@en ;
    dash:editor memorix:IriEditor ;
    sh:description "Plak hier eeen Adamlink URI in"@nl , "Please provide a Adamlink URI"@en ;
    sh:flags "i" ;
    sh:maxCount 1000 ;
    sh:message "Waarde moet beginnen met http of https"@nl , "Value must start with http:// or https://"@en ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://" ;
    sh:group deed:addressGroup ;
    sh:order 12.0 ;
    sh:path saa:hasOrHadSubjectLocation .

saa:hasOrHadSubjectCoordinates
    rdf:type sh:PropertyShape ;
    rdfs:label "Locatie coördinaten"@nl , "Location coordinates"@en ;
    dash:editor memorix:LocationCoordinatesEditor ;
    sh:class memorix:GeoCoordinates ;
    sh:maxCount 1000 ;
    sh:group deed:addressGroup ;
    sh:order 13.0 ;
    sh:path saa:hasOrHadSubjectCoordinates .

deed:LocationShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Locaties"@nl , "Locations"@en ;
    sh:class saa:Location ;
    sh:maxCount 100 ;
    sh:nodeKind sh:BlankNode ;
    sh:group deed:locationGroup ;
    sh:order 1.0 ;
    sh:path saa:isAssociatedWithLocation .

deed:AddressHouseNameShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Huisnaam"@nl , "House name"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:group deed:locationGroup ;
    sh:order 7.0 ;
    sh:path saa:houseName .

deed:AddressPlaceShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Plaats (anders dan Amsterdam)"@nl , "Place (other than Amsterdam)"@en ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:group deed:locationGroup ;
    sh:order 8.0 ;
    sh:path saa:placeName .

deed:AddressDescriptionShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Locatie omschrijving"@nl , "Location description"@en ;
    dash:editor dash:TextAreaEditor ;
    memorix:hidden true ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:group deed:locationGroup ;
    sh:order 9.0 ;
    sh:path saa:addressDescription .

deed:LodationIRIShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Locatie IRI"@nl , "Location IRI"@en ;
    dash:editor memorix:IriEditor ;
    memorix:hidden true ;
    sh:description "IRI naar een externe locatie identifier (BAG, Adamlink of anders)"@nl , "IRI of external location (BAG, Adamlink or other)"@en ;
    sh:flags "i" ;
    sh:maxCount 1 ;
    sh:message "Waarde moet beginnen met http of https"@nl , "Value must start with http:// or https://"@en ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^https?://" ;
    sh:group deed:locationGroup ;
    sh:order 12.0 ;
    sh:path deed:hasOrHadSubjectLocation .

deed:InternalRemarksShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Interne opmerking"@nl , "Internal remarks"@en ;
    dash:editor dash:TextAreaEditor ;
    memorix:audience memorix:AudienceInternal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:group deed:managementGroup ;
    sh:order 8.0 ;
    sh:path saa:internalRemarks .

deed:PositionOnScanShape
    rdf:type sh:PropertyShape ;
    rdfs:label "Positie op scan"@nl , "Position on scan"@en ;
    dash:editor dash:TextAreaEditor ;
    memorix:audience memorix:AudienceInternal ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:group deed:managementGroup ;
    sh:order 20.0 ;
    sh:path saa:positionOnScan .

saa:Address
    rdf:type sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        rdfs:label "Straatnaam in bron"@nl , "Migrated streetname"@en ;
        sh:datatype xsd:string ;
        sh:description "Straatnaam zoals het voorkomt in de bron."@nl , "Streetname mentioned in the source"@en ;
        sh:maxCount 1 ;
        sh:order 5.0 ;
        sh:path saa:streetTextualValue
    ] ;
    sh:property [
        rdfs:label "Straatnaam"@nl , "Street name"@en ;
        dash:editor memorix:VocabularyEditor ;
        memorix:conceptSchemeIn vocabularies:a4863c0c-d9e5-3902-831a-d0960e381a41 ;
        sh:class skos:Concept ;
        sh:description "Gestandaardiseerde straatnaam uit het conceptschema"@nl , "Standardized street name from concept scheme"@en ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:order 6.0 ;
        sh:path saa:street
    ] ;
    sh:property [
        rdfs:label "Huisnummer"@nl , "House number"@en ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 7.0 ;
        sh:path saa:houseNumber
    ] ;
    sh:property [
        rdfs:label "Huisnummer toevoeging"@nl , "House number addition"@en ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 8.0 ;
        sh:path saa:houseNumberAddition
    ] ;
    sh:targetClass saa:Address .

saa:HistoricalAddress1851
    rdf:type sh:NodeShape ;
    rdfs:label "Adres uit 1851-1853"@nl , "Address in 1851-1853"@en ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        rdfs:label "Straatnaam (1851-53)"@nl , "Street name (1851-53)"@en ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 1.0 ;
        sh:path saa:historicalAddress1851Street
    ] ;
    sh:property [
        rdfs:label "Kleinnummer"@nl , "Klein number"@en ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 2.0 ;
        sh:path saa:historicalAddressKleinNumber
    ] ;
    sh:targetClass saa:HistoricalAddress1851 .

saa:HistoricalAddress1853
    rdf:type sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        rdfs:label "Straatnaam (1853-74)"@nl , "Street name (1853-74)"@en ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 3.0 ;
        sh:path saa:historicalAddress1853Street
    ] ;
    sh:property [
        rdfs:label "Buurtcode"@nl , "Neighbourhood code"@en ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 4.0 ;
        sh:path saa:historicalAddressNeighbourhoodCode
    ] ;
    sh:property [
        rdfs:label "Buurtnummer"@nl , "Neighbourhood number"@en ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 5.0 ;
        sh:path saa:historicalAddressNeighbourhoodNumber
    ] ;
    sh:property [
        rdfs:label "Locatie URI (Adamlink)"@nl , "Location URI (Adamlink)"@en ;
        dash:editor memorix:IriEditor ;
        sh:description "Plak hier een Adamlink URI in"@nl , "Please provide a Adamlink URI"@en ;
        sh:flags "i" ;
        sh:maxCount 1000 ;
        sh:message "Waarde moet beginnen met http of https"@nl , "Value must start with http:// or https://"@en ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^https?://" ;
        sh:order 6.0 ;
        sh:path saa:hasOrHadHistoricalAddress1853SubjectLocation
    ] ;
    sh:targetClass saa:HistoricalAddress1853 .

saa:LinkedPersonObservation
    rdf:type sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        rdfs:label "order"@en ;
        memorix:hidden true ;
        sh:datatype xsd:integer ;
        sh:description "This field is required for persistent order of group items" ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:order 0.0 ;
        sh:path memorix:order
    ] ;
    sh:property [
        rdfs:label "Rol"@nl , "Role"@en ;
        dash:editor memorix:VocabularyEditor ;
        memorix:conceptSchemeIn vocabularies:a507438b-22fb-4a17-8f72-9c528cd6d1e9 ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:order 1.0 ;
        sh:path saa:relatedPersonObservationRole
    ] ;
    sh:property [
        rdfs:label "Persoonsvermelding"@nl , "Person observation"@en ;
        dash:editor memorix:LinkedRecordEditor ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class rt:PersonObservation ] ) ;
        sh:order 2.0 ;
        sh:path saa:relatedPersonObservation
    ] ;
    sh:targetClass saa:LinkedPersonObservation .

saa:Location
    rdf:type sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        rdfs:label "Locatie - Type"@nl , "Location type"@en ;
        dash:editor memorix:VocabularyEditor ;
        memorix:conceptSchemeIn vocabularies:a949c76c-3b78-4755-937f-a9abdeda17a9 ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:order 1.0 ;
        sh:path saa:locationType
    ] ;
    sh:property [
        rdfs:label "Locatie"@nl , "Location"@en ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 2.0 ;
        sh:path saa:locationTextualValue
    ] ;
    sh:targetClass saa:Location .

saa:Specification
    rdf:type sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        rdfs:label "Bijzonderheid - Type"@nl , "Detail type"@en ;
        dash:editor memorix:VocabularyEditor ;
        memorix:conceptSchemeIn vocabularies:6a1549c9-dd85-44e2-8424-2df0fbdf6fdc ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:order 1.0 ;
        sh:path saa:specificationType
    ] ;
    sh:property [
        rdfs:label "Bijzonderheid"@nl , "Detail"@en ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 2.0 ;
        sh:path saa:specificationTextualValue
    ] ;
    sh:targetClass saa:Specification .
