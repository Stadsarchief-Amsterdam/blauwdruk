PREFIX dash: <http://datashapes.org/dash#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX file: <https://stadsarchiefamsterdam.memorix.io/resources/recordtypes/File#>
PREFIX html: <http://www.w3.org/1999/xhtml/>
PREFIX memorix: <http://memorix.io/ontology#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX pnv: <https://w3id.org/pnv#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ric-dft: <https://www.ica.org/standards/RiC/vocabularies/documentaryFormTypes#>
PREFIX ric-rst: <https://www.ica.org/standards/RiC/vocabularies/recordSetTypes#>
PREFIX rico: <https://www.ica.org/standards/RiC/ontology#>
PREFIX rt: <https://stadsarchiefamsterdam.memorix.io/resources/recordtypes/>
PREFIX saa: <https://data.archief.amsterdam/ontology#>
PREFIX schema: <http://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX vocabularies: <https://stadsarchiefamsterdam.memorix.io/resources/vocabularies/conceptschemes/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

file:identificationGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Identificatie"@nl , "Identification"@en ;
    sh:order 1.0 .

file:contentDescriptionGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Beschrijving"@nl , "Description"@en ;
    sh:order 2.0 .

file:physicalDescriptionGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Fysieke kenmerken"@nl , "Physical description"@en ;
    sh:order 3.0 .

file:locationsGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Locaties"@nl , "Locations"@en ;
    sh:order 4.0 .

file:specialGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Specifieke kenmerken"@nl , "Specific details"@en ;
    sh:order 5.0 .

file:managementGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Beheer"@nl , "Manage"@en ;
    sh:order 6.0 .

rt:File
    rdf:type memorix:Recordtype , sh:NodeShape ;
    rdfs:comment "Bestanddeel: beschrijving van een of meerdere gegevensdragers, zoals correspondentie of een kasboek"@nl , "File: a description of one or more data carriers, such as correspondence or a ledger"@en ;
    rdfs:label "Bestanddeel"@nl , "File"@en ;
    dc:identifier "File" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        rdfs:label "Archief"@nl , "Fonds"@en ;
        dash:editor memorix:LinkedRecordEditor ;
        memorix:inSummaryAt 1.0 ;
        memorix:typeOf memorix:FondsFieldLink ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class rt:Fonds ] ) ;
        sh:group file:identificationGroup ;
        sh:order 1.0 ;
        sh:path file:fonds
    ] ;
    sh:property [
        rdfs:comment "Uniek nummer binnen een archiefblok."@nl ;
        rdfs:label "Inventarisnummer"@nl , "Inventory number"@en ;
        dash:singleLine true ;
        memorix:inTitleAt 1.0 ;
        memorix:searchWeight 3.0 ;
        memorix:typeOf memorix:Identifier ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "Vul tenminste een (uniek) inventarisnummer in. Dit nummer is verplicht."@nl , "Please provide at least an inventory number. It is required."@en ;
        sh:minCount 1 ;
        sh:group file:identificationGroup ;
        sh:order 2.0 ;
        sh:path rico:identifier
    ] ;
    sh:property [
        rdfs:comment "Korte beschrijving van dit inventarisnummer"@nl , "Title or short description"@en ;
        rdfs:label "Beschrijving"@nl , "Title"@en ;
        dash:editor dash:TextAreaEditor ;
        dash:singleLine false ;
        memorix:inTitleAt 2.0 ;
        memorix:searchWeight 5.0 ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group file:identificationGroup ;
        sh:order 3.0 ;
        sh:path rico:title
    ] ;
    sh:property [
        rdfs:comment "Uitgebreidere beschrijving, afkomstig uit NB velden"@nl , "A more descriptive note"@en ;
        rdfs:label "Nota bene"@nl , "Note"@en ;
        dash:editor dash:TextAreaEditor ;
        dash:singleLine false ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group file:identificationGroup ;
        sh:order 4.0 ;
        sh:path rico:scopeAndContent
    ] ;
    sh:property [
        rdfs:label "Uiterlijke vorm"@nl , "Resource extent"@en ;
        html:placeholder "Bv 2 pakken"@nl , "eg 2 photographs"@en ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group file:identificationGroup ;
        sh:order 5.0 ;
        sh:path rico:physicalOrLogicalExtent
    ] ;
    sh:property [
        rdfs:label "Documenttype"@nl , "Type of document"@en ;
        dash:editor memorix:VocabularyEditor ;
        memorix:conceptSchemeIn vocabularies:af136f00-7211-4355-a236-5a7ff7c25059 ;
        memorix:searchWeight 5.0 ;
        sh:class skos:Concept ;
        sh:maxCount 100 ;
        sh:message "Selecteer een waarde uit de lijst."@nl , "Select a value from the list"@en ;
        sh:nodeKind sh:IRI ;
        sh:group file:identificationGroup ;
        sh:order 6.0 ;
        sh:path rico:hasDocumentaryFormType
    ] ;
    sh:property [
        rdfs:comment "Kan een exacte datum of een periode zijn"@nl , "Exact date or date range"@en ;
        rdfs:label "Datering"@nl , "Dated"@en ;
        memorix:searchWeight 3.0 ;
        sh:class rico:DateRange ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNode ;
        sh:group file:contentDescriptionGroup ;
        sh:order 1.0 ;
        sh:path rico:isAssociatedWithDate
    ] ;
    sh:property [
        rdfs:label "Gerelateerde actoren"@nl , "Linked agents"@en ;
        memorix:searchWeight 3.0 ;
        sh:class saa:RelatedAgent ;
        sh:maxCount 100 ;
        sh:nodeKind sh:BlankNode ;
        sh:group file:contentDescriptionGroup ;
        sh:order 4.0 ;
        sh:path file:hasOrHadRelatedAgent
    ] ;
    sh:property [
        rdfs:label "Zie ook - verwijzing naar ander bestanddeel"@nl , "See also - link to another file"@en ;
        dash:editor memorix:LinkedRecordEditor ;
        sh:maxCount 50 ;
        sh:message "Selecteer een ander bestanddeel"@nl , "Please select another file to link to"@en ;
        sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class rt:File ] ) ;
        sh:group file:contentDescriptionGroup ;
        sh:order 5.0 ;
        sh:path rdfs:seeAlso
    ] ;
    sh:property [
        rdfs:label ""@nl , ""@en ;
        sh:class rico:Instantiation ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNode ;
        sh:group file:physicalDescriptionGroup ;
        sh:order 1.0 ;
        sh:path rico:hasInstantiation
    ] ;
    sh:property [
        rdfs:comment "Straatnamen en huisnummers"@nl , "Street and house number"@en ;
        rdfs:label "Betreffend adres"@nl , "Associated with address"@en ;
        sh:class saa:Address ;
        sh:maxCount 100 ;
        sh:nodeKind sh:BlankNode ;
        sh:group file:locationsGroup ;
        sh:order 1.0 ;
        sh:path file:isAssociatedWithAddress
    ] ;
    sh:property [
        rdfs:label "Locatie URI (BAG of Adamlink)"@nl , "Location URI (BAG or Adamlink)"@en ;
        dash:editor memorix:LocationBagEditor ;
        memorix:hidden true ;
        sh:class memorix:GeoCoordinates ;
        sh:maxCount 100 ;
        sh:group file:locationsGroup ;
        sh:order 2.0 ;
        sh:path file:hasOrHadSubjectLocation
    ] ;
    sh:property [
        rdfs:label "(oud) Locatie coördinaten"@nl , "(old) Location coordinates"@en ;
        dash:editor memorix:LocationCoordinatesEditor ;
        memorix:hidden true ;
        sh:class memorix:GeoCoordinates ;
        sh:maxCount 100 ;
        sh:group file:locationsGroup ;
        sh:order 3.0 ;
        sh:path file:hasOrHadSubjectCoordinates
    ] ;
    sh:property [
        rdfs:label "Kenmerk"@nl , "Specification"@en ;
        sh:class saa:Specification ;
        sh:maxCount 100 ;
        sh:nodeKind sh:BlankNode ;
        sh:group file:specialGroup ;
        sh:order 7.0 ;
        sh:path saa:hasSpecification
    ] ;
    sh:property [
        rdfs:label "Aanwinst"@nl , "Acquisition"@en ;
        dash:editor memorix:LinkedRecordEditor ;
        memorix:audience memorix:AudienceInternal ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class rt:Acquisition ] ) ;
        sh:group file:managementGroup ;
        sh:order 1.0 ;
        sh:path saa:isIncludedInAcquisition
    ] ;
    sh:property [
        rdfs:comment "Geeft aan of dit om een oorspronkelijk digitaal geboren stuk gaat"@nl , "Whether the records were digital born"@en ;
        rdfs:label "Digitaal geboren?"@nl , "Digital born?"@en ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:group file:managementGroup ;
        sh:order 2.0 ;
        sh:path file:digitalBorn
    ] ;
    sh:property [
        rdfs:comment "Geeft aan of dit stuk gedigitaliseerd is"@nl , "Whether the records were digitized or not"@en ;
        rdfs:label "Gedigitaliseerd?"@nl , "Digitized?"@en ;
        memorix:audience memorix:AudienceInternal ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:group file:managementGroup ;
        sh:order 3.0 ;
        sh:path file:digitised
    ] ;
    sh:property [
        rdfs:label "Hernoemde bestanden"@nl , "Renamed files"@en ;
        sh:class file:DigitalFilename ;
        sh:nodeKind sh:BlankNode ;
        sh:group file:managementGroup ;
        sh:order 4.0 ;
        sh:path file:hasRenamedFile
    ] ;
    sh:property [
        rdfs:label "Bergingsnummers"@nl , "Old storage numbers (bergingsnummers)"@en ;
        dash:editor dash:TextAreaEditor ;
        memorix:audience memorix:AudienceInternal ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group file:managementGroup ;
        sh:order 5.0 ;
        sh:path file:storageNumber
    ] ;
    sh:property [
        rdfs:label "Oude nummers"@nl , "Old numbers"@en ;
        dash:editor dash:TextAreaEditor ;
        memorix:audience memorix:AudienceInternal ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group file:managementGroup ;
        sh:order 6.0 ;
        sh:path file:oldNumbers
    ] ;
    sh:property [
        rdfs:label "Interne opmerking"@nl , "Internal remarks"@en ;
        dash:editor dash:TextAreaEditor ;
        memorix:audience memorix:AudienceInternal ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group file:managementGroup ;
        sh:order 7.0 ;
        sh:path saa:internalRemarks
    ] ;
    sh:property [
        rdfs:comment "Bijvoorbeeld: niet gecontroleerd, niet geregeld"@nl ;
        rdfs:label "Auteursrechtopmerking (intern)"@nl , "Copyright remarks (internal)"@en ;
        dash:editor dash:TextAreaEditor ;
        memorix:audience memorix:AudienceInternal ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group file:managementGroup ;
        sh:order 8.0 ;
        sh:path saa:copyrightsRemarks
    ] ;
    sh:property [
        rdfs:label "Duplicaat (kopie op film of microfiche)"@nl , "Duplicate (copy on film or microfiche)"@en ;
        dash:editor memorix:LinkedRecordEditor ;
        sh:maxCount 1 ;
        sh:message "Selecteer een duplicaat (filmnummer of microfiche)"@nl , "Please select a duplicate file"@en ;
        sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class rt:Duplicate ] ) ;
        sh:group file:managementGroup ;
        sh:order 9.0 ;
        sh:path file:duplicate
    ] ;
    sh:property [
        rdfs:label "Status"@nl , "Status"@en ;
        dash:editor dash:EnumSelectEditor ;
        memorix:audience memorix:AudienceInternal ;
        sh:datatype xsd:string ;
        sh:in ( "aanwezig" "depotlocatie elders" "in bewerking" "te vernietigen" "vermist" "vernietigd" "vervallen" ) ;
        sh:maxCount 1 ;
        sh:message "Status is verplicht. Kies uit de lijst"@nl , "Status is mandatory. Please choose from the list."@en ;
        sh:minCount 1 ;
        sh:group file:managementGroup ;
        sh:order 11.0 ;
        sh:path file:status
    ] ;
    sh:property [
        rdfs:label "Vermist sinds"@nl , "Missing since"@en ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:group file:managementGroup ;
        sh:order 12.0 ;
        sh:path file:missingSinceDate
    ] ;
    sh:property [
        rdfs:comment "Volgorde van bestanddelen"@nl , "Order of files"@en ;
        rdfs:label "Volgorde"@nl , "Ordering"@en ;
        dash:editor dash:TextAreaEditor ;
        dash:singleLine true ;
        memorix:hidden true ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group file:managementGroup ;
        sh:order 99.0 ;
        sh:path file:order
    ] ;
    sh:targetClass rt:File ;
    memorix:hasInformationComponent [
        rdf:type memorix:DepotLocationComponent , memorix:DigitalAssetComponent
    ] ;
    memorix:hasInformationComponent [
        rdf:type memorix:TreePathComponent ;
        memorix:hasRecordtype rt:Fonds , rt:Series
    ] ;
    memorix:typeOf memorix:File .

file:DigitalFilename
    rdf:type sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        rdfs:label "Oorspronkelijke bestandsnaam"@nl , "Original filename"@en ;
        memorix:audience memorix:AudienceInternal ;
        sh:datatype xsd:string ;
        sh:description "De oorspronkelijke bestandsnaam in het geval die hernoemd is."@nl , "Original filename, in case the file had to be renamed."@en ;
        sh:maxCount 1 ;
        sh:order 1.0 ;
        sh:path file:originalFilename
    ] ;
    sh:property [
        rdfs:label "Hernoemde Bestandsnaam"@nl , "Filename"@en ;
        memorix:audience memorix:AudienceInternal ;
        sh:datatype xsd:string ;
        sh:description "Nieuwe (hernoemde) bestandsnaam."@nl , "New renamed filename."@en ;
        sh:maxCount 1 ;
        sh:order 2.0 ;
        sh:path file:currentFilename
    ] ;
    sh:targetClass file:DigitalFilename .

rico:DateRange
    rdf:type sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        rdfs:label "Datum (tekst)"@nl , "Date (text)"@en ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 1.0 ;
        sh:path rico:expressedDate
    ] ;
    sh:property [
        rdfs:label "Begindatum"@nl , "Begin date"@en ;
        memorix:inSummaryAt 2 ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:order 2.0 ;
        sh:path rico:hasBeginningDate
    ] ;
    sh:property [
        rdfs:label "Einddatum"@nl , "End date"@en ;
        memorix:inSummaryAt 3 ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:order 3.0 ;
        sh:path rico:hasEndDate
    ] ;
    sh:targetClass rico:DateRange .

rico:Instantiation
    rdf:type sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        rdfs:comment "Tijdelijk veld om huidge data te migreren en later te standaardiseren" ;
        rdfs:label "Objecttype werkveld"@nl , "Migrated Object type"@en ;
        memorix:hidden true ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 1.0 ;
        sh:path saa:objectTypeTextualValue
    ] ;
    sh:property [
        rdfs:label "Objecttype"@nl , "Object type "@en ;
        dash:editor memorix:VocabularyEditor ;
        memorix:conceptSchemeIn vocabularies:1cc20db0-62dc-45cf-b7f7-c7b2fb2074a2 ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:message "Kies een objecttype uit de keuzelijst."@nl , "Please choose a object type from the list."@en ;
        sh:nodeKind sh:IRI ;
        sh:order 2.0 ;
        sh:path saa:objectType
    ] ;
    sh:property [
        rdfs:comment "Tijdelijk veld om huidge data te migreren en later te standaardiseren" ;
        rdfs:label "Techniek werkveld"@nl , "Migrated Technique"@en ;
        memorix:hidden true ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 3.0 ;
        sh:path saa:techniqueTextualValue
    ] ;
    sh:property [
        rdfs:label "Techniek"@nl , "Technique"@en ;
        dash:editor memorix:VocabularyEditor ;
        memorix:conceptSchemeIn vocabularies:d0fc28e9-e1c0-47c0-ad66-f496c8d12f90 ;
        sh:class skos:Concept ;
        sh:maxCount 50 ;
        sh:message "Kies een techniek uit de keuzelijst."@nl , "Please choose a technique from the list."@en ;
        sh:nodeKind sh:IRI ;
        sh:order 4.0 ;
        sh:path saa:technique
    ] ;
    sh:property [
        rdfs:comment "Tijdelijk veld om huidge data te migreren en later te standaardiseren" ;
        rdfs:label "Materialen werkveld"@nl , "Migrated Materials"@en ;
        memorix:hidden true ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 5.0 ;
        sh:path saa:materialTextualValue
    ] ;
    sh:property [
        rdfs:label "Materialen"@nl , "Materials"@en ;
        dash:editor memorix:VocabularyEditor ;
        memorix:conceptSchemeIn vocabularies:ae2e509f-ad1b-4dc3-bf0d-0fb9bc7e7863 ;
        sh:class skos:Concept ;
        sh:maxCount 50 ;
        sh:message "Kies een materiaal uit de keuzelijst."@nl , "Please choose a type of material from the list."@en ;
        sh:nodeKind sh:IRI ;
        sh:order 6.0 ;
        sh:path saa:material
    ] ;
    sh:property [
        rdfs:label "Afmetingen"@nl , "Dimensions"@en ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 7.0 ;
        sh:path rico:hasExtent
    ] ;
    sh:targetClass rico:Instantiation .

saa:Address
    rdf:type sh:NodeShape ;
    rdfs:subClassOf rico:Place ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        rdfs:label "Straatnaam"@nl , "Street name"@en ;
        dash:editor memorix:VocabularyEditor ;
        memorix:conceptSchemeIn vocabularies:a4863c0c-d9e5-3902-831a-d0960e381a41 ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:order 1.0 ;
        sh:path saa:street
    ] ;
    sh:property [
        rdfs:label "Huisnummer van"@nl , "House number from"@en ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 2.0 ;
        sh:path saa:houseNumberBegin
    ] ;
    sh:property [
        rdfs:label "Huisnummer tot"@nl , "House number to"@en ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 3.0 ;
        sh:path saa:houseNumberEnd
    ] ;
    sh:property [
        rdfs:label "Locatie URI (BAG)"@nl , "Location URI (BAG)"@en ;
        dash:editor memorix:IriEditor ;
        sh:description "Plak hier een BAG URI in"@nl , "Please provide a BAG URI"@en ;
        sh:flags "i" ;
        sh:maxCount 1000 ;
        sh:message "Waarde moet beginnen met http of https"@nl , "Value must start with http:// or https://"@en ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^https?://" ;
        sh:order 10.0 ;
        sh:path saa:hasOrHadSubjectBAGLocation
    ] ;
    sh:property [
        rdfs:label "Locatie (BAG) identifier"@nl , "Location (BAG) identifier"@en ;
        dash:singleLine true ;
        sh:datatype xsd:string ;
        sh:description "BAG identifier (alleen cijfers)"@nl , "BAG identifier, containing only numbers"@en ;
        sh:maxCount 1000 ;
        sh:message "De waarde moet een BAG identifier zijn (uitsluitend cijfers)"@nl , "Value must be a BAG ID conatining solely numbers"@en ;
        sh:order 11.0 ;
        sh:path saa:hasOrHadSubjectBAGIdentifier
    ] ;
    sh:property [
        rdfs:label "Locatie URI (Adamlink)"@nl , "Location URI (Adamlink)"@en ;
        dash:editor memorix:IriEditor ;
        sh:description "Plak hier een Adamlink URI in"@nl , "Please provide a Adamlink URI"@en ;
        sh:flags "i" ;
        sh:maxCount 1000 ;
        sh:message "Waarde moet beginnen met http of https"@nl , "Value must start with http:// or https://"@en ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^https?://" ;
        sh:order 12.0 ;
        sh:path saa:hasOrHadSubjectLocation
    ] ;
    sh:property [
        rdfs:label "Locatie coördinaten"@nl , "Locatie coordinates"@en ;
        dash:editor memorix:LocationCoordinatesEditor ;
        sh:class memorix:GeoCoordinates ;
        sh:maxCount 1 ;
        sh:order 13.0 ;
        sh:path saa:hasOrHadSubjectCoordinates
    ] ;
    sh:targetClass saa:Address .

saa:RelatedAgent
    rdf:type sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        rdfs:comment "Rol van gerelateerd persoon, organisatie of familie"@nl , "Role of related person, organisation or family"@en ;
        rdfs:label "Rol actor"@nl , "Role of related agent"@en ;
        dash:editor memorix:VocabularyEditor ;
        memorix:conceptSchemeIn vocabularies:0dada355-9e1e-4f1f-8d86-0455d6067bb7 ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:order 1.0 ;
        sh:path saa:hasRole
    ] ;
    sh:property [
        rdfs:comment "Actoren, bestaande uit een persoon, organisatie of familie"@nl , "Agent is a person, organisation or family"@en ;
        rdfs:label "Actor"@nl , "Agent"@en ;
        dash:editor memorix:LinkedRecordEditor ;
        sh:maxCount 1 ;
        sh:message "Kies een persoon, organisatie of familie uit de lijst."@nl , "Please choose a person, organisation or family"@en ;
        sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class rt:Person ] [ sh:class rt:Organisation ] [ sh:class rt:Family ] ) ;
        sh:order 2.0 ;
        sh:path saa:hasAgent
    ] ;
    sh:property [
        rdfs:label "Ongeïdentificeerde vervaardigers"@nl , "Unidentified creator"@en ;
        sh:datatype xsd:string ;
        sh:description "Veld om in tekst aangeleverde actoren in op te nemen, die niet nader ge´dentificeerd zijn. Eventueel later te standaardiseren"@nl , "Field for unidentified actors, to possibly standardize afterwards"@en ;
        sh:maxCount 1 ;
        sh:message "Voer één enkele vervaardiger in. Als er meer dan één vervaardiger is, gebruik je het herhaalbare veld."@nl , "Please type one creator. If there is more than one creator, use the recurrent field."@en ;
        sh:order 3.0 ;
        sh:path saa:hasUnidentifiedAgent
    ] ;
    sh:targetClass saa:RelatedAgent .

saa:Specification
    rdf:type sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        rdfs:label "Type Kenmerk"@nl , "Detail type"@en ;
