PREFIX dash: <http://datashapes.org/dash#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX html: <http://www.w3.org/1999/xhtml/>
PREFIX memorix: <http://memorix.io/ontology#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX pnv: <https://w3id.org/pnv#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ric-dft: <https://www.ica.org/standards/RiC/vocabularies/documentaryFormTypes#>
PREFIX ric-rst: <https://www.ica.org/standards/RiC/vocabularies/recordSetTypes#>
PREFIX rico: <https://www.ica.org/standards/RiC/ontology#>
PREFIX rt: <https://stadsarchiefamsterdam.memorix.io/resources/recordtypes/>
PREFIX saa: <https://data.archief.amsterdam/ontology#>
PREFIX schema: <http://schema.org/>
PREFIX series: <https://stadsarchiefamsterdam.memorix.io/resources/recordtypes/Series#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

series:identificationGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Identificatie"@nl , "Identification"@en ;
    sh:order 1.0 .

series:contentDescriptionGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Beschrijving"@nl , "Description"@en ;
    sh:order 2.0 .

series:managementGroup
    rdf:type sh:PropertyGroup ;
    rdfs:label "Beheer"@nl , "Manage"@en ;
    sh:order 3.0 .

rt:Series
    rdf:type memorix:Recordtype , sh:NodeShape ;
    rdfs:comment "Groep: beschrijving van een gegroepeerde set archiefstukken, bijvoorbeeld op thema, taakuitvoering of datering"@nl , "Series: a description of a grouped set of archival items, for example organized by theme, task, or date"@en ;
    rdfs:label "Groep"@nl , "Series"@en ;
    dc:identifier "Series" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        rdfs:label "Archief"@nl , "Fonds"@en ;
        dash:editor memorix:LinkedRecordEditor ;
        memorix:inSummaryAt 2 ;
        memorix:typeOf memorix:FondsFieldLink ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class rt:Fonds ] ) ;
        sh:group series:identificationGroup ;
        sh:order 1.0 ;
        sh:path saa:isOrWasAlsoIncludedIn
    ] ;
    sh:property [
        rdfs:comment "Voor het vastleggen van o.a. de basis archiefcode"@nl , "Code used by government archives"@en ;
        rdfs:label "Groepscode"@nl , "Archival (government) code"@en ;
        dash:singleLine true ;
        memorix:inTitleAt 1.0 ;
        memorix:searchWeight 3.0 ;
        memorix:typeOf memorix:Identifier ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group series:identificationGroup ;
        sh:order 2.0 ;
        sh:path rico:identifier
    ] ;
    sh:property [
        rdfs:label "Type groep"@nl , "Series type"@en ;
        dash:editor dash:EnumSelectEditor ;
        memorix:inSummaryAt 1 ;
        sh:datatype xsd:string ;
        sh:in ( "rubriek" "verzamelbeschrijving" ) ;
        sh:maxCount 1 ;
        sh:group series:identificationGroup ;
        sh:order 3.0 ;
        sh:path rico:hasRecordSetType
    ] ;
    sh:property [
        rdfs:label "Beschrijving"@nl , "Title"@en ;
        dash:editor dash:TextAreaEditor ;
        memorix:inTitleAt 2.0 ;
        memorix:searchWeight 5.0 ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:message "Geef een korte beschrijving. Dit is verplicht."@nl , "Please provide a title or short description. This is mandatory."@en ;
        sh:minCount 1 ;
        sh:group series:identificationGroup ;
        sh:order 4.0 ;
        sh:path rico:title
    ] ;
    sh:property [
        rdfs:comment "Uitgebreidere beschrijving, afkomstig uit NB velden"@nl , "A more descriptive note"@en ;
        rdfs:label "Nota bene"@nl , "Note"@en ;
        dash:editor dash:TextAreaEditor ;
        dash:singleLine false ;
        memorix:searchWeight 3.0 ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group series:identificationGroup ;
        sh:order 5.0 ;
        sh:path rico:scopeAndContent
    ] ;
    sh:property [
        rdfs:comment "Kan een exacte datum of een periode zijn"@nl , "Exact date or date range"@en ;
        rdfs:label "Datering VB"@nl , "Dated"@en ;
        sh:class rico:DateRange ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNode ;
        sh:group series:contentDescriptionGroup ;
        sh:order 1.0 ;
        sh:path rico:isAssociatedWithDate
    ] ;
    sh:property [
        rdfs:label "Uiterlijke vorm VB"@nl , "Resource extent"@en ;
        dash:editor dash:TextFieldEditor ;
        html:placeholder "Bv 2 pakken"@nl , "eg 2 photographs"@en ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group series:contentDescriptionGroup ;
        sh:order 3.0 ;
        sh:path rico:physicalOrLogicalExtent
    ] ;
    sh:property [
        rdfs:label "Interne opmerking"@nl , "Internal remarks"@en ;
        dash:editor dash:TextAreaEditor ;
        memorix:audience memorix:AudienceInternal ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group series:managementGroup ;
        sh:order 4.0 ;
        sh:path series:internalRemarks
    ] ;
    sh:targetClass rt:Series ;
    memorix:hasInformationComponent [ rdf:type memorix:DepotLocationComponent ] ;
    memorix:hasInformationComponent [
        rdf:type memorix:TreePathComponent ;
        memorix:hasRecordtype rt:Fonds , rt:Series
    ] .

rico:DateRange
    rdf:type sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        rdfs:label "Datum (tekst)"@nl , "Date (text)"@en ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 1.0 ;
        sh:path rico:expressedDate
    ] ;
    sh:property [
        rdfs:label "Begindatum"@nl , "Begin date"@en ;
        memorix:inTitleAt 3 ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:order 2.0 ;
        sh:path rico:hasBeginningDate
    ] ;
    sh:property [
        rdfs:label "Einddatum"@nl , "End date"@en ;
        memorix:inTitleAt 4 ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:order 3.0 ;
        sh:path rico:hasEndDate
    ] ;
    sh:targetClass rico:DateRange .
